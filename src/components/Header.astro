---
import { nav } from '../config';
const path = Astro.url.pathname;
---
<header class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-[15px]">
  <a href="/" class="font-bold"><span class="text-accent">~/</span>arnaud.rocks</a>
  <nav class="flex flex-wrap gap-x-5 gap-y-2">
    {nav.map((item) => (
      <a href={item.href} class:list={[path.startsWith(item.href) && 'text-accent']}>./{item.label.toLowerCase()}</a>
    ))}
  </nav>
</header>
