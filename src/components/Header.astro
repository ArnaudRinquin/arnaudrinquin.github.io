---
import { nav } from '../config';
const path = Astro.url.pathname;
---
<header class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-[15px]">
  <a href="/" class="font-bold"><span class="text-accent">~/</span>arnaud.rocks</a>
  <nav class="flex flex-wrap gap-x-5 gap-y-2">
    {nav.map((item) => (
      <a href={item.href} class:list={[path.startsWith(item.href) && 'text-accent']}>./{item.label.toLowerCase()}</a>
    ))}
    <button id="theme-toggle" type="button" class="flex cursor-pointer items-center gap-1.5 text-dim hover:text-accent" title="Theme (auto follows your system)"><svg data-icon="auto" class="hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg><svg data-icon="dark" class="hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg data-icon="light" class="hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span data-label>[auto]</span></button>
  </nav>
</header>

<script>
  // Cycles auto (system) → dark → light. "auto" removes the override.
  const modes = ['auto', 'dark', 'light'] as const;
  const button = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const current = () => (root.dataset.theme as (typeof modes)[number]) ?? 'auto';
  const render = () => {
    const mode = current();
    button.querySelector('[data-label]')!.textContent = `[${mode}]`;
    button.querySelectorAll('[data-icon]').forEach((icon) => icon.classList.toggle('hidden', icon.getAttribute('data-icon') !== mode));
  };
  render();
  button.addEventListener('click', () => {
    const next = modes[(modes.indexOf(current()) + 1) % modes.length];
    if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
    try { next === 'auto' ? localStorage.removeItem('theme') : localStorage.setItem('theme', next); } catch {}
    render();
  });
</script>
