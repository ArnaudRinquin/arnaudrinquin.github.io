---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<ul class="text-[17px]">
  {posts.map((p) => (
    <li class="border-b border-dashed border-line">
      <a href={`/blog/${p.id}/`} class="flex flex-wrap gap-x-4 gap-y-1 py-3">
        <time class="text-date" datetime={p.data.publishedAt.toISOString()}>{p.data.publishedAt.toISOString().slice(0, 10)}</time>
        <span>{p.data.title}</span>
      </a>
    </li>
  ))}
</ul>
