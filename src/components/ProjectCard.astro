---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
// priority: above the fold, so load it first (it's likely the LCP element).
interface Props { project: CollectionEntry<'projects'>; priority?: boolean }
const { project: p, priority = false } = Astro.props;
const folder = { 'side-project': 'side/', 'pro-bono': 'pro-bono/', talk: 'talks/' }[p.data.kind];
---
<a href={`/projects/${p.id}/`} class="flex flex-col overflow-hidden rounded-lg border border-line bg-panel hover:border-accent">
  {p.data.cover && (
    <Image src={p.data.cover} alt="" widths={[480, 976]} sizes="(min-width: 1040px) 488px, (min-width: 640px) calc(50vw - 32px), calc(100vw - 48px)" loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} class="aspect-[16/10] w-full border-b border-line object-cover" />
  )}
  <span class="flex flex-col gap-2.5 p-6">
    <span class="text-[13px] text-accent">{folder} · {p.data.year}</span>
    <span class="font-display text-2xl font-bold text-fg">{p.data.title}</span>
    <span class="text-sm leading-relaxed text-soft">{p.data.summary}</span>
  </span>
</a>
