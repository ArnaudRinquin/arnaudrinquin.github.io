---
// Pearlescent background, after hyperframes.heygen.com's "ground".
// - WebGL2 fragment shader: UVs folded by stacked sin/cos waves, sampled
//   three times with a tiny offset per channel -> iridescent RGB fringes.
// - A theme-coloured veil on top keeps it subtle and text readable.
// - Scroll nudges the flow; pauses when the tab is hidden.
// Reduced motion: a single still frame. No WebGL2: plain --bg.
---
<div class="pearl" aria-hidden="true">
  <canvas></canvas>
  <div class="veil"></div>
</div>

<script>
  const VERT = `#version 300 es
layout(location = 0) in vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

  const FRAG = `#version 300 es
precision highp float;
out vec4 fragColor;
uniform vec2 uRes;
uniform float uTime;
uniform vec3 uBase;

vec2 distort(vec2 p, float o) {
  p += o;
  for (float i = 1.0; i < 7.0; i++) {
    p.x += 0.3 / i * sin(i * 5.0 * p.y + uTime);
    p.y += 0.1 / i * cos(i * 3.0 * p.x + uTime);
  }
  return p;
}

void main() {
  vec2 uv = gl_FragCoord.xy / uRes;
  float r = sin(distort(uv, 0.00).x * 7.0) * 0.5 + 0.5;
  float g = sin(distort(uv, 0.02).x * 7.0) * 0.5 + 0.5;
  float b = sin(distort(uv, 0.04).x * 7.0) * 0.5 + 0.5;
  vec3 c = pow(vec3(r, g, b), vec3(10.0));
  fragColor = vec4(mix(uBase, c, 0.8), 1.0);
}`;

  const root = document.querySelector('.pearl') as HTMLElement;
  const canvas = root.querySelector('canvas') as HTMLCanvasElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const gl = canvas.getContext('webgl2', { alpha: false, antialias: false, depth: false, stencil: false });

  const compile = (type: number, src: string) => {
    const s = gl!.createShader(type)!;
    gl!.shaderSource(s, src);
    gl!.compileShader(s);
    if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) throw new Error(gl!.getShaderInfoLog(s) ?? 'compile');
    return s;
  };

  let prog: WebGLProgram | null = null;
  try {
    if (!gl) throw new Error('no webgl2');
    prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) ?? 'link');
  } catch (e) {
    console.warn('Pearl background unavailable', e);
    prog = null;
  }

  if (gl && prog) {
    root.classList.add('on');
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uBase = gl.getUniformLocation(prog, 'uBase');

    // Base under the waves: white in light mode, the theme bg in dark.
    const setBase = () => {
      const dark = getComputedStyle(document.documentElement).colorScheme.includes('dark');
      const hex = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      const n = parseInt(hex.slice(1), 16);
      const rgb = dark && hex.length === 7 ? [(n >> 16) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255] : [1, 1, 1];
      gl.uniform3f(uBase, rgb[0], rgb[1], rgb[2]);
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uRes, w, h);
    };

    let t = 0, last = 0, raf = 0;
    const draw = () => {
      gl.uniform1f(uTime, t + scrollY * 0.0006);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
    const frame = (now: number) => {
      const dt = Math.min(0.05, Math.max(0, (now - last) / 1000)) || 1 / 60;
      last = now;
      t += 0.225 * dt;
      draw();
      raf = requestAnimationFrame(frame);
    };
    const start = () => {
      if (raf || document.hidden || reduce.matches) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    const sync = () => { stop(); resize(); setBase(); draw(); start(); };

    sync();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduce.addEventListener('change', sync);
    new ResizeObserver(sync).observe(canvas);
    // Theme toggle (data-theme) or OS theme change.
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
    addEventListener('scroll', () => { if (!raf) draw(); }, { passive: true });
  }
</script>

<style>
  .pearl { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--bg); }
  .pearl canvas { display: none; width: 100%; height: 100%; }
  .pearl.on canvas { display: block; }
  /* Veil = theme bg at high alpha; tune --pearl-veil to taste. */
  .veil { position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) var(--pearl-veil, 78%), transparent); }
  /* Light: shader floor is grey-ish, so veil harder to keep it airy. */
  :global(:root[data-theme="light"]) .veil { --pearl-veil: 86%; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme="dark"])) .veil { --pearl-veil: 86%; } }
</style>
