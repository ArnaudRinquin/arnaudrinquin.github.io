---
// Click an image or a diagram (figure with an SVG) in a post to see it full screen.
---
<dialog id="lightbox" aria-label="Enlarged image">
  <button type="button" class="lb-close" aria-label="Close">esc ✕</button>
  <div class="lb-body"></div>
</dialog>

<style is:global>
  .prose img, .prose figure:has(svg) { cursor: zoom-in; }
  #lightbox {
    max-width: none; max-height: none; width: 100vw; height: 100dvh;
    margin: 0; padding: 0; border: 0;
    background: var(--bg);
    color: var(--fg);
  }
  #lightbox::backdrop { background: transparent; }
  #lightbox[open] { display: flex; align-items: center; justify-content: center; }
  #lightbox .lb-body {
    width: 100%; height: 100%; overflow: auto; cursor: zoom-out;
    display: flex; padding: 3rem 1rem 1rem;
  }
  #lightbox .lb-body > img { margin: auto; max-width: 100%; max-height: 100%; object-fit: contain; }
  #lightbox .lb-body > figure { width: min(100%, 1600px); margin: auto !important; }
  #lightbox .lb-body > figure svg { max-width: none !important; max-height: 85dvh; }
  #lightbox .lb-close {
    position: fixed; top: .75rem; right: 1rem; z-index: 1;
    font-family: var(--font-mono); font-size: .8rem; color: var(--dim);
    background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: .3rem .6rem; cursor: pointer;
  }
  #lightbox .lb-close:hover { color: var(--fg); }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const body = dialog.querySelector('.lb-body')!;

  function open(el: Element) {
    const clone = el.cloneNode(true) as HTMLElement;
    if (clone instanceof HTMLImageElement) {
      // Let the browser pick the biggest srcset candidate.
      clone.sizes = '100vw';
      clone.loading = 'eager';
      clone.removeAttribute('width');
      clone.removeAttribute('height');
    }
    clone.removeAttribute('id');
    body.replaceChildren(clone);
    dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('a')) return;
    const el = target.closest('.prose img, .prose figure:has(svg)');
    if (el && !dialog.contains(el)) open(el);
  });
  dialog.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => body.replaceChildren());
</script>
