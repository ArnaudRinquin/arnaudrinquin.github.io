---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---
<Layout title="Projects">
  <h1 class="mb-8 text-3xl font-semibold">Projects</h1>
  <ul class="space-y-6">
    {projects.map((p) => (
      <li>
        <a href={`/projects/${p.id}/`} class="text-lg font-medium">{p.data.title}</a>
        <span class="text-sm text-muted">{p.data.year}</span>
        <p class="text-muted">{p.data.summary}</p>
      </li>
    ))}
  </ul>
</Layout>
