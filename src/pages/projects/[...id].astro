---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, role, stack, url, repo, cover } = project.data;
---
<Layout title={title} description={summary}>
  <article>
    <h1 class="mb-2 text-3xl font-semibold">{title}</h1>
    <p class="mb-6 text-muted">{summary}</p>
    <dl class="mb-8 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
      <dt class="text-muted">Year</dt><dd>{year}</dd>
      {role && <><dt class="text-muted">Role</dt><dd>{role}</dd></>}
      {stack.length > 0 && <><dt class="text-muted">Stack</dt><dd>{stack.join(', ')}</dd></>}
      {url && <><dt class="text-muted">Link</dt><dd><a href={url} class="underline">{new URL(url).host}</a></dd></>}
      {repo && <><dt class="text-muted">Code</dt><dd><a href={repo} class="underline">Repository</a></dd></>}
    </dl>
    {cover && <Image src={cover} alt="" class="mb-8 rounded" />}
    <div class="prose"><Content /></div>
  </article>
</Layout>
