---
import Layout from '../../layouts/Layout.astro';
import Prompt from '../../components/Prompt.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, role, stack, url, repo, cover } = project.data;
---
<Layout title={title} description={summary}>
  <article>
    <Prompt>cat projects/{project.id}/README.md</Prompt>
    <h1 class="mb-4 font-display text-[clamp(2rem,5vw,3.25rem)] leading-tight font-bold tracking-tight">{title}</h1>
    <p class="mb-8 text-lg text-soft">{summary}</p>
    <dl class="mb-10 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
      <dt class="text-dim">year</dt><dd>{year}</dd>
      {role && <><dt class="text-dim">role</dt><dd>{role}</dd></>}
      {stack.length > 0 && <><dt class="text-dim">stack</dt><dd>{stack.join(', ')}</dd></>}
      {url && <><dt class="text-dim">url</dt><dd><a href={url} class="text-accent">{new URL(url).host}</a></dd></>}
      {repo && <><dt class="text-dim">code</dt><dd><a href={repo} class="text-accent">{new URL(repo).pathname.slice(1)}</a></dd></>}
    </dl>
    {cover && <Image src={cover} alt="" class="mb-10 rounded-lg border border-line" />}
    <div class="prose"><Content /></div>
    <p class="mt-16"><a href="/projects/" class="text-dim">cd ../</a></p>
  </article>
</Layout>
