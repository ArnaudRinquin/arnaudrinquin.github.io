---
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate } from '../../data/posts';
const posts = await getPosts();
---
<Layout title="Blog">
  <h1 class="mb-8 text-3xl font-semibold">Blog</h1>
  <ul class="space-y-6">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`} class="text-lg font-medium">{p.data.title}</a>
        <p class="text-muted">{p.data.description}</p>
        <time class="text-sm text-muted" datetime={p.data.publishedAt.toISOString()}>{formatDate(p.data.publishedAt)}</time>
      </li>
    ))}
  </ul>
</Layout>
