---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPosts, formatDate } from '../data/posts';

const posts = (await getPosts()).slice(0, 3);
const featured = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => b.data.year - a.data.year);
---
<Layout>
  <section class="mb-16">
    <h1 class="mb-4 text-3xl font-semibold">Hi, I'm Arnaud.</h1>
    <p class="text-lg text-muted">TODO: short intro — what I do now, what I'm open to.</p>
  </section>

  {featured.length > 0 && (
    <section class="mb-16">
      <h2 class="mb-4 text-xl font-semibold"><a href="/projects/">Selected projects</a></h2>
      <ul class="space-y-3">
        {featured.map((p) => (
          <li><a href={`/projects/${p.id}/`} class="font-medium">{p.data.title}</a> <span class="text-muted">— {p.data.summary}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <h2 class="mb-4 text-xl font-semibold"><a href="/blog/">Latest writing</a></h2>
    <ul class="space-y-3">
      {posts.map((p) => (
        <li><a href={`/blog/${p.id}/`} class="font-medium">{p.data.title}</a> <span class="text-sm text-muted">{formatDate(p.data.publishedAt)}</span></li>
      ))}
    </ul>
  </section>
</Layout>
