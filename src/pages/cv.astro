---
import Layout from '../layouts/Layout.astro';
import Prompt from '../components/Prompt.astro';
import { site } from '../config';
import { cv } from '../data/cv';
---
<Layout title="CV" description={`${site.name}, ${cv.headline}. Experience, education and skills.`}>
  <Prompt>cat cv.md <span class="no-print">· <button onclick="window.print()" class="cursor-pointer underline underline-offset-4 hover:text-accent">print / pdf</button></span></Prompt>
  <h1 class="cursor mb-2 font-display text-5xl font-bold tracking-tight">{site.name}</h1>
  <p class="mb-8 text-lg">{cv.headline} <span class="text-dim">· {cv.location}</span></p>
  <div class="mb-16 max-w-3xl space-y-3 leading-relaxed text-soft">{cv.summary.map((p) => <p>{p}</p>)}</div>

  <h2 class="mb-6 font-display text-3xl font-bold"><span class="text-accent">#</span> Experience</h2>
  <ol class="mb-16 space-y-10">
    {cv.experience.map((job) => (
      <li class="break-inside-avoid border-l border-line pl-6">
        <p class="font-display text-xl font-bold">{job.role} <span class="text-accent">@</span> {job.company}</p>
        <p class="mb-3 text-sm text-dim"><span class="text-date">{job.start} – {job.end ?? 'present'}</span>{job.location && ` · ${job.location}`}</p>
        {job.description.length > 0 && <div class="max-w-3xl space-y-2 text-[15px] leading-relaxed text-soft">{job.description.map((p) => <p>{p}</p>)}</div>}
        {job.skills && <p class="mt-3 text-sm text-dim">{job.skills.map((s) => `[${s}]`).join(' ')}</p>}
      </li>
    ))}
  </ol>

  <h2 class="mb-6 font-display text-3xl font-bold"><span class="text-accent">#</span> Education</h2>
  <ul class="mb-16 space-y-3">
    {cv.education.map((e) => (
      <li>{e.degree} <span class="text-accent">@</span> {e.school} <span class="text-sm text-date">{e.start}–{e.end}</span></li>
    ))}
  </ul>

  <h2 class="mb-6 font-display text-3xl font-bold"><span class="text-accent">#</span> Skills</h2>
  <p class="mb-16 text-soft">{cv.skills.map((s) => `[${s}]`).join(' ')}</p>
  <h2 class="mb-6 font-display text-3xl font-bold"><span class="text-accent">#</span> Languages</h2>
  <p class="text-soft">{cv.languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</p>
</Layout>
