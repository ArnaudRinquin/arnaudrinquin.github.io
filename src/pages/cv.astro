---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { cv } from '../data/cv';
---
<Layout title="CV">
  <h1 class="text-3xl font-semibold">{site.name}</h1>
  <p class="mb-6 text-lg">{cv.headline} · <span class="text-muted">{cv.location}</span></p>
  <div class="mb-10 space-y-3 text-muted">{cv.summary.map((p) => <p>{p}</p>)}</div>

  <h2 class="mb-4 text-xl font-semibold">Experience</h2>
  <ol class="mb-10 space-y-8">
    {cv.experience.map((job) => (
      <li class="break-inside-avoid">
        <p><span class="font-medium">{job.role}</span> · {job.company}</p>
        <p class="text-sm text-muted">{job.start} – {job.end ?? 'present'}{job.location && ` · ${job.location}`}</p>
        {job.description.length > 0 && <div class="mt-2 space-y-2">{job.description.map((p) => <p>{p}</p>)}</div>}
        {job.skills && <p class="mt-2 text-sm text-muted">{job.skills.join(' · ')}</p>}
      </li>
    ))}
  </ol>

  <h2 class="mb-4 text-xl font-semibold">Education</h2>
  <ul class="mb-10 space-y-3">
    {cv.education.map((e) => (
      <li><span class="font-medium">{e.degree}</span> · {e.school} <span class="text-sm text-muted">{e.start}–{e.end}</span></li>
    ))}
  </ul>

  <h2 class="mb-4 text-xl font-semibold">Skills</h2>
  <p class="mb-10">{cv.skills.join(' · ')}</p>
  <h2 class="mb-4 text-xl font-semibold">Languages</h2>
  <p>{cv.languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</p>
</Layout>
